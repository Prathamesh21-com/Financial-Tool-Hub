# ============================================================
# Financial Tool Hub — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# AI API Keys (at least one required for AI chat features)
# ============================================================

# Google Gemini API Key (Recommended — Free tier available)
# Get from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative — Paid)
# Get from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Admin Panel
# ============================================================

# Admin password for the admin panel (change this!)
VITE_ADMIN_PASSWORD=admin@FTH2024

# ============================================================
# App Configuration
# ============================================================

# App name (do not change)
VITE_APP_NAME=Financial Tool Hub

# App URL (for production)
VITE_APP_URL=https://financialtoolhub.com

# ============================================================
# Firebase (Optional — for cloud sync)
# ============================================================
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ============================================================
# Analytics (Optional)
# ============================================================
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
